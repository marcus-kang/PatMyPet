CREATE TABLE Diary
(
    diaryId         INT              NOT NULL, 
    petId           INT              NOT NULL, 
    diaryDate       DATE             NOT NULL, 
    walkVenue       VARCHAR2(40)     NULL, 
    walkStart       VARCHAR2(20)     NULL, 
    walkStop        VARCHAR2(20)     NULL, 
    walkDistance    VARCHAR2(40)     NULL, 
    pee             VARCHAR2(20)     NULL, 
    poo             VARCHAR2(20)     NULL, 
    note            CLOB			 NULL, 
    eatTime         VARCHAR2(20)     NULL, 
    food            VARCHAR2(100)    NULL, 
    weight          VARCHAR2(20)     NULL, 
    condition       CLOB 		     NULL, 
    CONSTRAINT DIARY_PK PRIMARY KEY (diaryId)
)

CREATE TABLE Pet
(
    petId         INT              NOT NULL, 
    userId        INT              NULL, 
    petName       VARCHAR2(40)     NULL, 
    petImg        VARCHAR2(200)    NULL, 
    petBirth      DATE             NULL, 
    petGender     VARCHAR2(2)      NULL, 
    petSpecies    VARCHAR2(40)     NULL, 
    CONSTRAINT PET_PK PRIMARY KEY (petId)
)

